<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="maryna_hladka2.Views.SettingsPage"
             Title="Налаштування">

    <VerticalStackLayout Padding="20" Spacing="16">

        <Label Text="Вигляд" FontSize="22" FontAttributes="Bold" />

        <HorizontalStackLayout Spacing="12">
            <Label Text="Темна тема" VerticalOptions="Center" />
            <Switch IsToggled="{Binding IsDarkTheme, Mode=TwoWay}" />
        </HorizontalStackLayout>

        <BoxView HeightRequest="1" Color="Gray" Margin="0,10" />

        <Label Text="Стан сесії (IAppStateService)" FontAttributes="Bold" />
        <Label Text="{Binding SessionInfo}" />
        <BoxView HeightRequest="1" Color="Gray" Margin="0,10" />

        <Label Text="Тест deep link" FontAttributes="Bold" />
        <Label Text="Id студента:" />
        <Entry Text="{Binding DeepLinkStudentId, Mode=TwoWay}"
       Keyboard="Numeric"
       Placeholder="Наприклад, 1" />
        <Button Text="Відкрити студента за посиланням"
        Command="{Binding TestDeepLinkCommand}" />
    </VerticalStackLayout>
    
</ContentPage>