<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="maryna_hladka2.StudentDetailPage"
             Title="Деталі студента">

    <VerticalStackLayout Padding="20" Spacing="14">

        <Label Text="ПІБ:" FontAttributes="Bold" />
        <Label Text="{Binding FullName}" />

        <Label Text="Група:" FontAttributes="Bold" />
        <Label Text="{Binding Group}" />

        <Label Text="Середній бал:" FontAttributes="Bold" />
        <Stepper Minimum="0" Maximum="5" Increment="0.1"
                 Value="{Binding AverageScore, Mode=TwoWay}" />
        <Label Text="{Binding AverageScore, StringFormat='Поточне значення: {0:F1}'}" />

        <HorizontalStackLayout Spacing="10" Margin="0,20,0,0">
            <Button Text="Зберегти" Command="{Binding SaveCommand}" />
            <Button Text="Назад" Command="{Binding GoBackCommand}" />
        </HorizontalStackLayout>

    </VerticalStackLayout>
</ContentPage>